<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>multi_explore_mapping</name>
  <version>0.0.1</version>
  <description>Multi-robot SLAM and map merging with ICP alignment</description>
  <maintainer email="naoki@todo.todo">naoki</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 既存の依存 -->
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>rclcpp_action</depend>

  <!-- ✅ ICP実装に必要な依存を追加 -->
  <depend>Eigen3</depend>
  <depend>opencv</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_geometry_msgs</depend>

  <depend>visualization_msgs</depend>

  <!-- launch 時に必要だが C++ リンク不要 (exec only) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>multirobot_map_merge</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>